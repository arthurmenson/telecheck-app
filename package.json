{
  "name": "telecheck-app",
  "version": "0.0.1",
  "private": true,
  "description": "Telecheck multi-tenant AI-powered telehealth platform â€” implementation of the spec corpus in arthurmenson/telecheckONE",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:kms": "vitest run -c vitest.kms.config.ts",
    "check:log-call-sites": "node scripts/check-log-call-sites.mjs",
    "bench": "vitest bench --run -c vitest.bench.config.ts",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"tests/**/*.{ts,tsx}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"tests/**/*.{ts,tsx}\" \"*.{json,md}\"",
    "typecheck": "tsc --noEmit",
    "check:migration-bom": "node scripts/check-migration-bom.mjs",
    "migrate:apply": "node scripts/migrate.mjs",
    "verify:identity-runtime": "tsx scripts/verify-identity-runtime.ts",
    "verify:forms-publication": "tsx scripts/verify-forms-publication.ts",
    "verify:forms-rollback": "tsx scripts/verify-forms-rollback.ts",
    "verify:patient-reads": "tsx scripts/verify-patient-reads.mjs",
    "verify:care-intake": "node --import tsx scripts/verify-care-intake-ci.mjs",
    "test:care-intake": "vitest run -c vitest.care.config.ts",
    "verify:care-consent": "tsx scripts/verify-care-consent.mjs",
    "test:migrations": "node --test scripts/lib/migration-source.test.mjs scripts/migrate.integration.test.mjs",
    "openapi:validate": "echo 'TODO: wire swagger-cli validate against ../telecheckONE/Telecheck Master Bundle FINAL US REGION BASELINE/Telecheck_OpenAPI_v0_2.md'",
    "migrate:diff": "echo 'TODO: wire prisma migrate diff against current schema'",
    "prepare": "echo 'TODO: husky install once first slice begins'",
    "ner:setup": "node scripts/setup-ner-model.mjs",
    "ner:verify": "node scripts/verify-ner-model.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1127.0",
    "@aws-sdk/client-sts": "3.1127.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/sensible": "^6.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.1.0",
    "onnxruntime-node": "1.24.3",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "tokenizers": "0.23.2",
    "ulid": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.29.0",
    "pino-pretty": "13.1.3",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
